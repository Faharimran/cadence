# ── Database ──────────────────────────────────────────────────────────
# Two connections, on purpose:
#
#   DATABASE_URL      owner/superuser — prisma migrate, db push, scripts/applyRls.ts
#   DATABASE_APP_URL  the application's non-superuser role
#
# They must differ. Postgres bypasses row-level security for superusers and for a
# table's owner, so an app that connects as the owner has RLS silently disabled —
# the isolation would look configured and enforce nothing.
#
# Port 5432 assumes a native Postgres already running (Homebrew, Postgres.app).
# If you use the bundled docker-compose.yml instead, change 5432 -> 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cadence?schema=public"
DATABASE_APP_URL="postgresql://cadence_app:cadence_app@localhost:5432/cadence?schema=public"

# ── Redis (queues, conversation snapshots, rate limits) ───────────────
# The /1 suffix selects a Redis database index. Use a dedicated one if this Redis
# is shared with another project — BullMQ key names would otherwise collide.
# With docker-compose.yml, change 6379 -> 6380.
REDIS_URL="redis://localhost:6379/1"

# ── Conversation layer ────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Only needed when the key above is an IDENTITY-LINKED key (one tied to a person
# rather than a workspace). Those return 400 on every request until told which
# workspace to act in. Find it in the Console URL when viewing a workspace:
# console.anthropic.com/settings/workspaces/<wrkspc_...>
ANTHROPIC_WORKSPACE_ID=""

# ── Platform ──────────────────────────────────────────────────────────
# Pepper for API-key hashing and the default webhook signing secret.
# Rotating this invalidates every existing API key.
CADENCE_SECRET=""
# Public base URL, used when building absolute links in webhook payloads.
CADENCE_BASE_URL="http://localhost:3000"
