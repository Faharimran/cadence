{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant scheduling, availability and conversation infrastructure.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx workers/index.ts",
    "worker:dev": "dotenv -e .env.local -- tsx watch workers/index.ts",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:rls": "dotenv -e .env.local -- tsx scripts/applyRls.ts",
    "seed:demo": "dotenv -e .env.local -- tsx scripts/seedDemoTenant.ts",
    "prove:engine": "dotenv -e .env.local -- tsx scripts/proveEngine.ts",
    "prove:conversation": "dotenv -e .env.local -- tsx scripts/proveConversation.ts",
    "prove": "npm run prove:engine && npm run prove:conversation && npm run prove:delivery",
    "live:conversation": "dotenv -e .env.local -- tsx scripts/liveConversation.ts",
    "prove:webhook": "dotenv -e .env.local -- tsx scripts/proveWebhook.ts",
    "user": "dotenv -e .env.local -- tsx scripts/createUser.ts",
    "prove:auth": "dotenv -e .env.local -- tsx scripts/proveAuth.ts",
    "prove:delivery": "dotenv -e .env.local -- tsx scripts/proveWebhookDelivery.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.78.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "next": "16.2.7",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rrule": "^2.8.1",
    "tsx": "^4.22.4",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
