// cadence — multi-tenant scheduling, availability and conversation infrastructure.
//
// Two conventions run through this whole file:
//
//   1. Closed vocabularies the ENGINE branches on are Prisma `enum`s. Open
//      vocabularies the TENANT defines are `String` + a config row they own
//      (see ExceptionType). If you find yourself wanting to add a value to an
//      enum for one customer, that value belongs in their config, not here.
//
//   2. Availability is never stored. There is no `isAvailable`, no `isBooked`,
//      no nightly job that materialises free slots. Layers 1-3 below are facts;
//      the answer is computed per query in lib/engine/availability.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════
//  Platform & tenancy
// ══════════════════════════════════════════════════════════════════════

/// One business. Every tenant-scoped table carries `tenantId` and is additionally
/// protected by Postgres row-level security (scripts/applyRls.ts) — the app filter
/// is the fast path, RLS is the backstop for the query someone forgets to scope.
model Tenant {
  id     String @id @default(cuid())
  slug   String @unique // URL/API-safe handle, e.g. "cara-clinic"
  name   String
  status String @default("active") // active | suspended

  /// Fallback IANA timezone for locations that don't set their own. There is no
  /// hardcoded default anywhere in the codebase — a tenant must choose one.
  timezone String

  /// ISO-4217. Money is stored everywhere as an integer in the currency's minor
  /// unit (paise, cents) so no float rounding ever touches a price.
  ///
  /// Deliberately has no default. It used to default to INR — harmless while
  /// there was one customer in Mumbai, and exactly the kind of assumption that
  /// silently prices a London barber in rupees. Onboarding asks.
  currency String

  /// Tax presentation is per-tenant, not per-country-we-guessed. `taxLabel` is what
  /// the customer sees ("GST", "VAT"); `taxRate` is a percentage; `taxInclusive`
  /// says whether listed prices already contain it.
  taxLabel     String? // null = don't show tax at all
  taxRate      Float   @default(0)
  taxInclusive Boolean @default(true)

  // ── How this business wants to be spoken for ──────────────────────
  // Everything below is prompt material. It exists because the difference
  // between a hair clinic and a barber is not schema — both put a person in a
  // chair for a duration — it is what the business knows, what it refuses to
  // say, and how it says it. Holding that as tenant data rather than as string
  // literals in agent.ts is what stops the engine acquiring a vertical.

  /// One or two sentences on what this place is, in the owner's words. The
  /// assistant is otherwise told only a business name, which is not enough to
  /// know whether "do you take walk-ins?" is even a sensible question.
  descriptor String?

  /// How to write. Free text rather than an enum, because "warm and brief" and
  /// "formal, always use Mr/Ms" are both legitimate and neither is a checkbox.
  toneNote String?

  /// Subjects that must always go to a person, in the business's own words. A
  /// clinic needs "anything clinical"; a garage needs "quoting a repair before
  /// we've seen the car"; a barber may need none. Shipping the clinic's list to
  /// every tenant is the mistake this replaces.
  escalationTopics String[] @default([])

  /// House rules, in the owner's own words, placed in the system prompt as
  /// their instructions. Separate from `toneNote` because tone is a small,
  /// preset-backed "how to sound", and this is everything else they want the
  /// assistant to know or do — the field people actually mean when they ask to
  /// edit the prompt.
  ///
  /// It sits ABOVE the correctness rules and cannot remove them. Those are not
  /// style: they are what stop a price being invented, a time being re-rendered
  /// into the wrong timezone, or a held slot being announced as lost.
  agentInstructions String?

  /// Which model answers, and how hard it thinks. Null on both means the
  /// platform default, so a tenant who never opens the page keeps whatever is
  /// best today rather than being pinned to whatever was best the day they
  /// signed up.
  ///
  /// Validated against lib/conversation/models.ts on write. Free text here
  /// would let a typo 500 every conversation for one tenant and nobody else,
  /// which is the worst blast radius there is to notice.
  agentModel  String?
  agentEffort String? // low | medium | high

  /// Which preset this tenant was created from ("clinic", "barber", …).
  /// Provenance and presentation ONLY. Nothing in the engine or the agent may
  /// branch on it, or the vertical is back in the code where it does not belong.
  vertical String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  apiKeys          ApiKey[]
  capabilities     TenantCapability[]
  locations        Location[]
  resources        Resource[]
  services         Service[]
  exceptionTypes   ExceptionType[]
  exceptions       ScheduleException[]
  customers        Customer[]
  bookings         Booking[]
  promotions       Promotion[]
  conversations    Conversation[]
  channelAccounts  ChannelAccount[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  knowledgeDocs    KnowledgeDoc[]
  knowledgeSources KnowledgeSource[]
  sheetLinks       SheetLink[]
  importRuns       ImportRun[]

  @@index([status])
}

/// A person who signs in to the admin UI.
///
/// Scoped to one tenant. `email` is globally unique rather than unique per
/// tenant, because the sign-in form asks only for an email — requiring people to
/// also type which business they work for is a worse trade than the rare case of
/// someone needing two logins for two businesses.
model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String   @unique
  name         String?
  /// scrypt, salted per user. Never a plain hash — see lib/auth/password.ts.
  passwordHash String
  role         UserRole @default(staff)
  active       Boolean  @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, active])
}

/// Someone who runs cadence itself, rather than a business on it.
///
/// A separate table from `User`, not a flag on it, and the reason is structural:
/// every `User` belongs to a tenant, and a platform operator belongs to none.
/// Expressing "no tenant" as a nullable column would put a null check between
/// every query and its tenant scope — the exact check that gets forgotten once.
/// Two tables cannot be confused for one another.
///
/// Deliberately NOT in the row-level-security list in scripts/applyRls.ts. It
/// carries no tenantId, so a tenant policy has nothing to key on; it is instead
/// protected by never being reachable from a tenant session (see
/// lib/platform/session.ts, which signs with a different HMAC domain).
model PlatformUser {
  id String @id @default(cuid())

  email        String       @unique
  name         String?
  /// scrypt, same as User. Shares lib/auth/password.ts.
  passwordHash String
  role         PlatformRole @default(support)
  active       Boolean      @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

enum PlatformRole {
  /// Read-only. Sees health and volume, changes nothing.
  support
  /// May suspend and reactivate a tenant. Every such act is audited.
  admin
}

/// Closed set — authorization branches on these, so adding one is a code change.
enum UserRole {
  /// Everything, including users, billing and channel credentials.
  owner
  /// Day-to-day configuration: services, resources, schedules, exceptions.
  manager
  /// Front desk: record leave and closures, work conversations, view bookings.
  staff
}

/// An API credential. Only the hash is stored; the plaintext is shown once at
/// creation and is unrecoverable. `prefix` is the first few characters, kept in
/// clear so a key can be identified in a UI or a log without being usable.
model ApiKey {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  prefix     String    @unique // e.g. "cdn_live_a1b2c3"
  hash       String // sha256(secret + CADENCE_SECRET)
  scopes     String[]  @default(["read", "write"])
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, revokedAt])
}

/// Where each capability's data actually lives, per tenant. This is the hinge the
/// whole product turns on: a tenant with no CRM runs everything `hosted`; a tenant
/// on Zenoti runs availability + bookings `brokered` through a connector; both use
/// the identical engine interface and the identical agent tools.
///
/// The conversation layer reads this to assemble its per-tenant toolset — a
/// capability that is neither hosted nor brokered simply yields no tool, so the
/// agent cannot offer something the tenant can't deliver.
model TenantCapability {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  capability Capability
  mode       CapabilityMode @default(hosted)

  /// Which adapter serves this when `brokered` (e.g. "zenoti", "cara", "hubspot").
  connector String?
  /// Adapter-specific settings — base URL, field mappings, sync cadence.
  /// Validated with a per-connector Zod schema at the write boundary; never read
  /// raw. Anything read in more than one place has earned a real column.
  config    Json?

  /// How long a snapshot of this capability stays usable in a conversation before
  /// it must be refreshed. Availability is deliberately tiny; a catalog is hours.
  snapshotTtlSeconds Int @default(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, capability])
  @@index([tenantId])
}

/// Closed set — each value has an implementation behind it. Adding one is a code
/// change, deliberately.
enum Capability {
  customers
  catalog
  availability
  booking_read
  booking_write
  promotions
  knowledge
  notifications
}

enum CapabilityMode {
  hosted // cadence's own tables are the system of record
  brokered // the tenant's system is the system of record; we read/write through
}

// ══════════════════════════════════════════════════════════════════════
//  Core domain — deliberately vertical-neutral
// ══════════════════════════════════════════════════════════════════════

/// A physical or virtual place things are booked at. Carries its OWN timezone:
/// a tenant can run branches in different zones, and inheriting silently from the
/// tenant is how you end up double-booking across a DST boundary.
model Location {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  code     String? // short handle used in references
  timezone String // IANA, e.g. "Asia/Kolkata", "Europe/London"
  address  String?
  active   Boolean @default(true)

  externalId String? // id in the tenant's own system, when brokered

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources     ResourceLocation[]
  scheduleRules ScheduleRule[]
  exceptions    ScheduleException[]
  bookings      Booking[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

/// Anything that can be occupied by a booking: a person, a room, a machine, a chair.
/// One abstraction rather than three tables, because the availability maths is
/// identical and a booking routinely needs several at once (a surgeon AND a theatre).
model Resource {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  kind ResourceKind @default(person)

  /// Tenant-defined labels used to match a service's requirements
  /// (e.g. ["Hair", "Surgeon"] or ["Chair", "Wash"]). Open vocabulary on purpose.
  tags String[] @default([])

  /// Employment/enabled flag set by an admin. DISTINCT from presence below, and
  /// distinct again from whether the resource is bookable at a given instant —
  /// that third thing is computed, never stored.
  active Boolean @default(true)

  /// Day-to-day presence, for live routing and walk-ins. Never consulted when
  /// answering "is 3pm next Tuesday free" — that is Layers 1-3's job.
  presence   String   @default("available") // available | busy | break | offline
  presenceAt DateTime @default(now())

  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations     ResourceLocation[]
  scheduleRules ScheduleRule[]
  exceptions    ScheduleException[]
  bookings      BookingResource[]

  @@index([tenantId, active])
  @@index([tenantId, externalId])
}

enum ResourceKind {
  person
  room
  equipment
}

/// Resources rotate between locations, so this is many-to-many rather than a
/// column on Resource.
model ResourceLocation {
  /// Denormalised from the parents purely so this table can carry the same
  /// row-level-security policy as every other one. See the note on
  /// BookingResource.tenantId.
  tenantId   String
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([resourceId, locationId])
  @@index([locationId])
  @@index([tenantId])
}

/// A bookable offering with a duration and a price.
model Service {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  category    String? // tenant-defined; used to scope exceptions and promotions
  description String?

  durationMinutes     Int
  /// Padding around the appointment that also blocks the resource — cleanup,
  /// turnover, notes. Included in the interval written to BookingResource, so the
  /// overlap constraint enforces it for free.
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  /// Minor units of Tenant.currency. Null = "price on request", which is a real
  /// and common case: some businesses must not quote a firm number in chat.
  priceMinor Int?

  /// When false the conversation layer will describe the service but never state
  /// a number, regardless of `priceMinor`. This exists because quoting a total is
  /// a compliance question in several verticals, not a UI preference.
  priceQuotable Boolean @default(true)

  active     Boolean @default(true)
  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements ServiceRequirement[]
  bookings     Booking[]

  @@index([tenantId, active])
  @@index([tenantId, category])
}

/// What a service needs to be bookable. A haircut needs one resource tagged
/// "Stylist". A transplant needs one "Surgeon" and one "Theatre" for six hours.
model ServiceRequirement {
  id        String  @id @default(cuid())
  tenantId  String
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// Match resources carrying ALL of these tags.
  tags     String[]      @default([])
  kind     ResourceKind?
  /// How many distinct matching resources this service occupies.
  quantity Int           @default(1)

  @@index([serviceId])
}

// ══════════════════════════════════════════════════════════════════════
//  Layer 1 — the recurring pattern
// ══════════════════════════════════════════════════════════════════════

/// "This resource works Mondays 10:00-14:00 at Santacruz." Times are LOCAL
/// wall-clock strings resolved against Location.timezone at query time, never
/// instants — otherwise a schedule silently shifts by an hour at a DST boundary.
///
/// A schedule change closes the current row with `effectiveTo` and opens a new
/// one, so historical availability stays reconstructible.
model ScheduleRule {
  id       String @id @default(cuid())
  tenantId String

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  weekday   Int // 0 = Sunday .. 6 = Saturday, in the location's timezone
  startTime String // "10:00"
  endTime   String // "14:00"

  /// Granularity of the offered grid. Slots are generated on this cadence; a
  /// service longer than one slot simply occupies several.
  slotMinutes Int @default(30)

  effectiveFrom DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())

  @@index([tenantId, resourceId, weekday])
  @@index([locationId])
}

// ══════════════════════════════════════════════════════════════════════
//  Layer 2 — exceptions (tenant-customisable)
// ══════════════════════════════════════════════════════════════════════

/// The customisable half of Layer 2. A tenant invents "OT Day", "Camp Sunday",
/// "Study Leave", "Machine Servicing" — labels, colours, approval requirements and
/// customer-facing wording are all theirs.
///
/// What they do NOT get to invent is `effect`. The engine understands exactly two
/// verbs, and that is the line that keeps this a scheduling product rather than an
/// unversioned rules DSL with no debugger.
model ExceptionType {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code  String // stable handle, referenced by seeds and connectors
  label String // staff-facing display name, freely editable

  // ── engine contract: closed, code-owned ──
  effect     ExceptionEffect
  onConflict ConflictPolicy  @default(block)

  // ── freely customisable ──
  defaultPriority  Int     @default(0)
  requiresApproval Boolean @default(false)
  colour           String?

  /// Whether an exception of this type may be described to a customer at all.
  /// Defaults to FALSE: staff write internal reasons like "root canal, back Thu"
  /// and the agent must never repeat them. Opting in requires a deliberate flip
  /// plus wording in `defaultPublicReason`.
  publicVisible       Boolean @default(false)
  defaultPublicReason String?

  /// True for types the code references by `code`. Cannot be deleted or have its
  /// effect changed through the API.
  systemLocked Boolean @default(false)
  active       Boolean @default(true)

  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions ScheduleException[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

enum ExceptionEffect {
  subtract // leave, closure, theatre day, equipment down
  add // extra session, weekend camp, one-off overtime
}

enum ConflictPolicy {
  block // refuse to create the exception while bookings collide with it
  rebook // accept, flag colliding bookings for rebooking, notify
}

/// One concrete window of altered availability.
///
/// The nullable scoping columns are the expressive core:
///   resourceId NULL + locationId SET  → the whole location (a public holiday)
///   resourceId SET  + locationId NULL → that person everywhere (personal leave)
///   both NULL                         → the entire tenant (company shutdown)
/// and `serviceCategories` narrows further: "in the building, but no procedures".
model ScheduleException {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  typeId String
  type   ExceptionType @relation(fields: [typeId], references: [id])

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  /// Empty = affects every service. Otherwise only these categories.
  serviceCategories String[] @default([])

  /// Overrides ExceptionType.defaultPriority. Higher wins when two exceptions
  /// disagree — this is how "we ARE open on the public holiday" is expressed.
  priority Int @default(0)

  status ExceptionStatus @default(approved)

  requestedById String?
  approvedById  String?
  approvedAt    DateTime? @db.Timestamptz(3)

  /// Internal reason is never shown to a customer. Public reason is only used when
  /// the type has publicVisible = true.
  internalReason String?
  publicReason   String?

  /// RFC 5545 RRULE for repeating exceptions ("every second Saturday"). Null for
  /// one-offs. Expanded at query time, bounded by `recurrenceEnd`.
  recurrence    String?
  recurrenceEnd DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startsAt, endsAt])
  @@index([resourceId, startsAt])
  @@index([locationId, startsAt])
}

enum ExceptionStatus {
  requested
  approved
  rejected
}

// ══════════════════════════════════════════════════════════════════════
//  Layer 3 — customers and bookings
// ══════════════════════════════════════════════════════════════════════

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String?
  /// E.164. Normalised on write against the tenant's default region — there is no
  /// global assumption about country code.
  phone String?
  email String?

  locale   String? // BCP-47, drives the conversation language
  timezone String? // overrides the location's zone when confirming times

  /// Suppresses ALL outbound messaging. Checked before the agent emits a token.
  optedOut Boolean @default(false)

  externalId String?
  attributes Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings      Booking[]
  conversations Conversation[]

  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, externalId])
}

/// A reservation. `held` is a short-lived soft lock taken while the agent waits for
/// the customer to confirm — without it, every slot the bot offers is a race it
/// will sometimes lose after promising.
///
/// The real double-booking guard is NOT here: it is an exclusion constraint on
/// BookingResource (scripts/applyRls.ts). Application-level checking loses to
/// concurrency eventually, and "eventually" means "with two real customers".
model Booking {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  /// Instants, always UTC. The customer-facing local time is derived from
  /// Location.timezone (or Customer.timezone) at render time.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  status BookingStatus @default(held)

  /// Only set while status = held. Swept by workers/holdExpiry.ts.
  holdExpiresAt DateTime? @db.Timestamptz(3)

  source String @default("api") // api | agent | admin | connector

  /// Set when the tenant's own system is the system of record; this is the id
  /// over there. Its absence on a brokered tenant means the write hasn't landed.
  externalId String?

  /// Snapshot of price at booking time, in minor units. A promotion that ends
  /// tomorrow must not silently reprice yesterday's booking.
  priceMinor     Int?
  discountMinor  Int?
  promotionId    String?
  promotion      Promotion? @relation(fields: [promotionId], references: [id])
  promotionLabel String? // denormalised: survives the promotion being deleted

  notes        String?
  cancelReason String?
  cancelledAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources BookingResource[]

  @@index([tenantId, startsAt])
  @@index([tenantId, status, holdExpiresAt])
  @@index([customerId])
  @@index([tenantId, externalId])
}

enum BookingStatus {
  held
  scheduled
  confirmed
  completed
  cancelled
  no_show
  needs_rebooking
}

/// Which resources a booking occupies, and for exactly which interval.
///
/// `startsAt`/`endsAt`/`active` are deliberately DENORMALISED from Booking. They
/// have to live on this row because the overlap-prevention constraint is per
/// resource-interval, and Postgres exclusion constraints cannot reach across a
/// join. They are written in the same transaction as the parent booking.
///
/// The interval here includes the service's buffers, so turnover time is enforced
/// by the same constraint that prevents double-booking.
model BookingResource {
  id        String  @id @default(cuid())
  /// Denormalised from Booking. Every table in this schema carries `tenantId` so
  /// the RLS policy is one uniform, indexable predicate rather than an EXISTS
  /// subquery on some tables and a column comparison on others — a rule you can
  /// audit beats a rule you have to remember the exceptions to.
  tenantId  String
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  /// Mirrors "the parent booking occupies time": true for held/scheduled/
  /// confirmed/completed, false for cancelled/no_show/needs_rebooking. The
  /// exclusion constraint is filtered on it.
  active   Boolean  @default(true)

  @@unique([bookingId, resourceId])
  @@index([resourceId, startsAt])
  @@index([resourceId, active])
}

// ══════════════════════════════════════════════════════════════════════
//  Pricing rules
// ══════════════════════════════════════════════════════════════════════

/// A time-boxed pricing rule. The rule is stored here; the OUTCOME is snapshotted
/// onto the booking. When the festival ends, historical bookings keep the price
/// they were actually sold at.
model Promotion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code              String?
  name              String
  /// Customer-facing wording the agent may use verbatim. When null, the agent
  /// says an offer exists and hands off rather than inventing a description.
  publicDescription String?

  discountType     DiscountType
  discountValue    Float
  /// Cap on a percentage discount, in minor units.
  maxDiscountMinor Int?

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  /// Empty arrays = applies to everything in scope.
  locationIds String[] @default([])
  categories  String[] @default([])
  serviceIds  String[] @default([])

  stackable Boolean @default(false)
  priority  Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@unique([tenantId, code])
  @@index([tenantId, active, startsAt, endsAt])
}

enum DiscountType {
  percent
  flat
}

// ══════════════════════════════════════════════════════════════════════
//  Conversation layer
// ══════════════════════════════════════════════════════════════════════

/// One continuous thread with a customer on one channel. The transcript is the
/// agent's state — there is no separate session object to drift out of sync.
model Conversation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  channel          String // whatsapp | web | sms | instagram
  externalThreadId String? // channel-side conversation id

  status String @default("open") // open | closed

  /// Set the moment a human takes over. The agent must go silent on this thread
  /// until it is cleared, or staff and bot talk over each other in front of the
  /// customer.
  botPaused   Boolean   @default(false)
  botPausedAt DateTime? @db.Timestamptz(3)

  /// Last time the operational snapshot backing this conversation was refreshed.
  snapshotAt DateTime? @db.Timestamptz(3)

  lastInboundAt  DateTime? @db.Timestamptz(3)
  lastOutboundAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@unique([tenantId, channel, externalThreadId])
  @@index([tenantId, status])
  @@index([customerId])
}

/// A messaging identity a tenant owns — one WhatsApp business number, one web
/// widget, one SMS long code.
///
/// This is what makes inbound routing work in a multi-tenant product. Meta posts
/// every message for an app to ONE webhook URL; the only thing distinguishing
/// tenants in that payload is `metadata.phone_number_id`. So that value is the
/// lookup key, and it is globally unique by definition — two businesses cannot
/// own the same number.
model ChannelAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channel String // whatsapp | web | sms

  /// The provider's id for this identity. For WhatsApp this is
  /// `phone_number_id`, which arrives on every inbound payload.
  externalAccountId String  @unique
  displayNumber     String?

  /// Credentials for sending as this identity.
  ///
  /// Encrypted at rest with AES-256-GCM (lib/crypto.ts) — a leaked row here
  /// would otherwise let an attacker message that business's entire customer
  /// list. Values are sealed on write and opened only at the moment of use.
  accessToken String?
  /// App secret, used to verify X-Hub-Signature-256 on inbound payloads.
  appSecret   String?
  /// Shared secret for the one-time webhook subscription handshake.
  verifyToken String?

  active Boolean @default(true)
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, channel, externalAccountId])
  @@index([tenantId, active])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction String // inbound | outbound
  /// agent | human | customer | system
  author    String
  body      String

  /// What the model did this turn — tool calls and their results, for audit.
  toolTrace Json?

  /// Which snapshot the agent was looking at when it said this, and which
  /// knowledge chunks it read. This is how you answer "your bot told me 3pm was
  /// free" three weeks later, and how you tell stale data from a model error.
  snapshotAt DateTime? @db.Timestamptz(3)
  sources    String[]  @default([])

  externalId String? // channel-side message id, for delivery receipts
  status     String? // sent | delivered | read | failed

  /// Why a failed message failed, in words an owner can act on.
  ///
  /// "Not delivered" on its own sends someone to us, or to nobody. The reason is
  /// almost always an expired access token, which they can fix themselves in
  /// two minutes — but only if something tells them that is what happened.
  failureReason String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([externalId])
}

// ══════════════════════════════════════════════════════════════════════
//  Knowledge — what the business knows, in its own words
// ══════════════════════════════════════════════════════════════════════

/// A single thing the business knows and is willing to have repeated.
///
/// This is where a vertical actually lives. The schema cannot tell a barber from
/// a clinic — both book a person into a chair for a duration — but their answers
/// to "what should I expect?" have nothing in common. Rather than modelling
/// hair-transplant aftercare or fade types, cadence models *the business having
/// written something down*, and the difference between verticals becomes rows.
///
/// Three rules, in descending order of how much trouble they save:
///
///  1. **Only `approved` is ever readable by the assistant.** A draft is not
///     ranked lower, it is absent — the search tool filters on status, so an
///     unreviewed paragraph cannot reach a customer even if the model asks for
///     it by name.
///
///  2. **Editing an approved doc returns it to draft.** Changing aftercare
///     advice and having it go live unread is precisely the failure that makes
///     an approval step worth having. The old text stays live until someone
///     signs off the new one — see KnowledgeRevision.
///
///  3. **The model may quote it, never summarise the business into existence.**
///     Anything not written here is not known, and the prompt says so.
model KnowledgeDoc {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Where this came from, when it was not typed by hand. Set for every chunk
  /// lifted out of an uploaded document, so a reviewer can see which file and
  /// which page a paragraph belongs to before signing it off — and so a customer
  /// asking "where does it say that?" has an answer.
  sourceId   String?
  source     KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// 1-based page in the original document. Null for hand-written articles.
  sourcePage Int?

  /// Phrased as the customer would ask it — "How long does recovery take?" —
  /// because the title is matched against their question, so it earns its keep.
  title String
  /// Markdown, written by the business. Never generated, never edited by us.
  body  String

  /// Free vocabulary, tenant's own. Used to narrow a search and to group the
  /// list screen. Open on purpose, like Resource.tags.
  tags String[] @default([])

  status KnowledgeStatus @default(draft)

  /// Bumped every time an edit is approved. Quoted in provenance so "what did
  /// the bot tell people in August" has an answer.
  version Int @default(1)

  /// Attribution follows the ScheduleException convention: plain ids, not
  /// relations. A user who leaves is deactivated, not deleted, and their name
  /// resolves at read time.
  authorId     String?
  approvedById String?
  approvedAt   DateTime? @db.Timestamptz(3)

  // Full-text search adds no column here on purpose. It is a GIN index over the
  // expression `knowledge_tsv(title, body)` — see the migration. A stored
  // generated column was tried first and had to be abandoned: Prisma cannot
  // express GENERATED, so it read the column as drift, offered to reset the
  // database on every `migrate dev`, and then emitted DDL Postgres rejects.
  // An expression index is invisible to Prisma for the same reason the
  // exclusion constraint on BookingResource is, and costs nothing in speed.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions KnowledgeRevision[]

  /// Two docs with the same title is always a mistake — someone edited a copy.
  @@unique([tenantId, title])
  @@index([tenantId, status])
  @@index([sourceId])
}

/// A document a business uploaded, and the record of what was made from it.
///
/// The file itself is deliberately NOT stored. What a business uploads is often
/// an internal deck carrying dealer cost, margin bands or half-finished pricing;
/// keeping the original around means keeping a liability whose only use is to be
/// leaked. What is worth keeping is the extracted text — reviewable, editable,
/// and the thing the chunks were actually derived from.
///
/// `checksum` is what makes re-uploading the same brochure idempotent instead of
/// doubling every article in the corpus.
model KnowledgeSource {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// file | web. A website is a living source: re-reading it is expected, and
  /// the same address read twice is the same source updated, not a second copy.
  /// A file is fixed, and two uploads of the same bytes are likewise one source.
  kind String @default("file")

  /// Where a web source was read from. Null for uploads.
  sourceUrl String?

  filename  String
  mimeType  String
  byteSize  Int
  /// SHA-256 of the uploaded bytes for a file; of the address for a website.
  ///
  /// Hashing the ADDRESS rather than the fetched text is deliberate: a site
  /// whose wording changed slightly is the same source read again, and hashing
  /// its content would strand the old articles under an orphaned source every
  /// time somebody fixed a typo on their homepage.
  checksum  String
  pageCount Int?

  /// Everything the extractor got, page-delimited. Kept so a reviewer can see
  /// what a chunk was taken from, and so re-chunking never needs the file back.
  extractedText String?

  status      KnowledgeSourceStatus @default(extracting)
  /// Why it failed, in words a receptionist can act on ("this PDF is a scan —
  /// there is no text in it to read").
  failureNote String?

  /// How many drafts came out of it. Denormalised because the list screen shows
  /// it for every source and the docs themselves may since have been deleted.
  chunkCount Int @default(0)

  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  docs KnowledgeDoc[]

  /// The same file uploaded twice is the same source, not a second copy.
  @@unique([tenantId, checksum])
  @@index([tenantId, status])
}

enum KnowledgeSourceStatus {
  /// Text is being pulled out and split up.
  extracting
  /// Chunks exist as drafts and are waiting for someone to read them.
  review
  /// Every chunk from it has been approved or discarded.
  done
  /// Nothing usable came out. `failureNote` says why.
  failed
}

enum KnowledgeStatus {
  /// Written, not signed off. Invisible to the assistant.
  draft
  /// Signed off. The only status the search tool will return.
  approved
  /// Retired but kept, because a conversation three months ago cited it.
  archived
}

/// The text exactly as it was at one approved version.
///
/// Not an audit nicety: `ConversationMessage.sources` records which doc AND
/// version a reply drew on, and that reference is worthless if the doc has been
/// rewritten since. This is what lets you answer "your bot told me I could
/// shower on day two" by showing what the bot was actually reading.
model KnowledgeRevision {
  id       String @id @default(cuid())
  tenantId String

  docId String
  doc   KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  version Int
  title   String
  body    String

  authorId     String?
  approvedById String?

  createdAt DateTime @default(now())

  @@unique([docId, version])
  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════════════
//  Platform plumbing
// ══════════════════════════════════════════════════════════════════════

/// Makes POST retries safe. A client that times out and retries with the same
/// key gets the original response replayed rather than a second booking.
model IdempotencyRecord {
  id       String @id @default(cuid())
  tenantId String

  key          String
  /// Hash of method + path + body. A same-key-different-body replay is a client
  /// bug and must 422 rather than silently returning the wrong response.
  requestHash  String
  statusCode   Int
  responseBody Json

  createdAt DateTime @default(now())
  expiresAt DateTime @db.Timestamptz(3)

  @@unique([tenantId, key])
  @@index([expiresAt])
}

model WebhookEndpoint {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  url    String
  secret String // HMAC-SHA256 signing secret, per endpoint
  events String[] @default([])
  active Boolean  @default(true)

  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId, active])
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  tenantId   String
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  event   String
  payload Json

  attempts      Int       @default(0)
  status        String    @default("pending") // pending | delivered | failed
  lastError     String?
  lastAttemptAt DateTime?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([endpointId])
}

model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actor   String // apiKey:<prefix> | user:<id> | agent | system
  action  String // exception.created | promotion.updated | booking.cancelled
  subject String // "<model>:<id>"
  before  Json?
  after   Json?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([subject])
}

// ══════════════════════════════════════════════════════════════════════
//  Importing from whatever the business used before
// ══════════════════════════════════════════════════════════════════════

/**
 * A spreadsheet the business keeps, which cadence re-reads on a schedule.
 * The premise is that the sheet stays THEIRS. A salon that has priced its
 * services in the same spreadsheet for six years is not going to retype it here
 * and then maintain two copies; whichever copy is easier to edit becomes the
 * real one, and it will not be ours. So the sheet remains the source of truth
 * and cadence follows it.
 * Nothing here is Google-specific except how the URL is resolved. Any source
 * that can produce rows and columns — an Excel export, a Zoho or Zenoti CSV —
 * lands in the same pipeline, which is the point: businesses arrive from
 * software we have never heard of, and all of it exports a table.
 */
model SheetLink {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What the person pasted, kept verbatim so the UI can show them their own
  /// link rather than a normalised one they will not recognise.
  sourceUrl String
  /// The resolved CSV endpoint we actually fetch. Derived, cached, and re-derived
  /// whenever sourceUrl changes.
  fetchUrl  String
  /// Which tab. Google calls it a gid; null means the first sheet.
  gid       String?

  /// Which of our tables this sheet feeds. Deliberately one kind per link: a
  /// sheet holding services and customers in the same tab is a sheet the owner
  /// should split, and guessing per-row is how an import writes a price into a
  /// phone number field.
  kind String // services | customers

  /// Column header → our field name, as agreed with the owner. Stored so a
  /// scheduled re-read never depends on a model call, and so the mapping cannot
  /// silently change under them between two syncs.
  mapping Json

  /// Whether rows that disappear from the sheet should be deactivated here.
  ///
  /// Off by default, and it stays off unless someone deliberately turns it on.
  /// A sheet that fails to load half its rows, or an owner filtering a view,
  /// would otherwise retire a whole price list — and unlike a bad value, an
  /// absent row gives nothing to notice.
  removeMissing Boolean @default(false)

  status    String  @default("active") // active | paused | error
  lastError String?

  lastSyncAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runs ImportRun[]

  @@index([tenantId, status])
}

/**
 * One pass over one sheet, and everything needed to take it back.
 * `undo` is why this model exists. Imports here apply immediately rather than
 * waiting for approval, which is only defensible if undoing is one click and
 * genuinely complete — so every run records the prior value of each field it
 * changed and the ids of everything it created, before it changes anything.
 * Kept even for runs that changed nothing: "it ran and did nothing" and "it
 * never ran" look identical afterwards and need different responses.
 */
model ImportRun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  linkId String
  link   SheetLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  /// scheduled | manual — a sync someone watched and one that happened at 3am
  /// are read differently when something has gone wrong.
  trigger String @default("manual")

  status String @default("ok") // ok | failed | reverted

  rowsRead Int @default(0)
  created  Int @default(0)
  updated  Int @default(0)
  skipped  Int @default(0)

  /// Per-row complaints, kept as data rather than a log line, because the person
  /// who needs them is looking at a screen and the fix is in their spreadsheet.
  issues Json?

  /// Prior state of everything this run touched. See revert().
  undo Json?

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime? @db.Timestamptz(3)
  revertedAt DateTime? @db.Timestamptz(3)

  @@index([tenantId, startedAt])
  @@index([linkId, startedAt])
}
